{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx tests/movesets.mjs && node --import tsx tests/president-ultimates.mjs && node --import tsx tests/combat-balance.mjs",
    "start": "node --import tsx server.ts",
    "dev:server": "node --import tsx --watch server.ts --dev",
    "test:sprites": "node --import tsx tests/sprite-atlas.mjs && node --import tsx tests/sprite-replay.mjs && node --import tsx tests/roster-art.mjs && node --import tsx tests/ultimate-art.mjs",
    "test:rooms": "node --test tests/rooms.mjs && node --import tsx tests/online-combat.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@napi-rs/canvas": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.52.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ws": "^8.23.0"
  }
}
